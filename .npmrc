# vitest 4 vs. el peerOptional vitest@^3.1.1 de @angular/build 20 entran en
# conflicto. Los workflows de .github/workflows/ ya instalaban con
# --legacy-peer-deps; fijarlo acá hace que local, CI y sesiones remotas
# resuelvan igual en vez de depender de que cada invocación pase el flag.
legacy-peer-deps=true
